#jinja2: lstrip_blocks: True
services:
  netbootxyz:
    container_name: netbootxyz
    image: {{ netboot_image }}:{{ netboot_version }}
    restart: {{ netboot_restart_policy }}
    environment:
      PUID: "{{ netboot_puid }}"
      PGID: "{{ netboot_pgid }}"
      TZ: {{ netboot_tz }}
{% if netboot_menu_version %}
      MENU_VERSION: {{ netboot_menu_version }}
{% endif %}
      PORT_RANGE: "{{ netboot_port_range }}"
      SUBFOLDER: {{ netboot_subfolder }}
      NGINX_PORT: "{{ netboot_nginx_port }}"
      WEB_APP_PORT: "{{ netboot_web_app_port }}"
    volumes:
      - {{ netboot_config_volume }}:/config
      - {{ netboot_assets_volume }}:/assets
    ports:
      - "{{ netboot_web_port }}:{{ netboot_web_app_port }}"
      - "{{ netboot_tftp_port }}:69/udp"
      - "{{ netboot_http_port }}:{{ netboot_nginx_port }}"
{% if netboot_mem_limit %}
    mem_limit: {{ netboot_mem_limit }}
{% endif %}
{% if netboot_cpus %}
    cpus: {{ netboot_cpus }}
{% endif %}
{% if netboot_no_new_privileges %}
    security_opt:
      - no-new-privileges:true
{% endif %}
{% if netboot_drop_all_caps %}
    cap_drop:
      - ALL
{% endif %}
{% if netboot_read_only %}
    read_only: true
    tmpfs:
      - /tmp
      - /run
{% endif %}
{% if netboot_log_max_size %}
    logging:
      driver: json-file
      options:
        max-size: "{{ netboot_log_max_size }}"
        max-file: "{{ netboot_log_max_file }}"
{% endif %}

volumes:
  {{ netboot_config_volume }}:
  {{ netboot_assets_volume }}:
