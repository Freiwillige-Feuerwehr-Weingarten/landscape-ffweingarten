# Tenzu application env. Pydantic-style nested settings use double
# underscores: TENZU_DB__HOST sets settings.db.host, etc.

# ---------- Core ----------
TENZU_DEBUG={{ tenzu_debug }}
TENZU_SECRET_KEY={{ tenzu_secret_key }}
TENZU_TOKENS__SIGNING_KEY={{ tenzu_tokens_signing_key }}
TENZU_BACKEND_URL="{{ tenzu_backend_url }}"
TENZU_FRONTEND_URL="{{ tenzu_frontend_url }}"
TENZU_EXTRA_CORS='{{ tenzu_extra_cors }}'
TENZU_REQUIRED_TERMS={{ tenzu_required_terms }}
TENZU_MAX_PAGE_SIZE={{ tenzu_max_page_size }}
TENZU_SUPPORT_EMAIL="{{ tenzu_support_email }}"

# ---------- Database ----------
TENZU_DB__NAME={{ tenzu_db_name }}
TENZU_DB__USER={{ tenzu_db_user }}
TENZU_DB__PASSWORD={{ tenzu_db_password }}
TENZU_DB__HOST=tenzu-db

# Exposed to compose for the postgres container itself
TENZU_DB_PASSWORD={{ tenzu_db_password }}

# ---------- Redis ----------
TENZU_EVENTS__REDIS_HOST=tenzu-redis
TENZU_EVENTS__REDIS_OPTIONS='{"health_check_interval": 5}'

# ---------- Tokens ----------
TENZU_TOKENS__ACCESS_TOKEN_LIFETIME={{ tenzu_access_token_lifetime }}
TENZU_TOKENS__REFRESH_TOKEN_LIFETIME={{ tenzu_refresh_token_lifetime }}

# ---------- Storage (MinIO via S3) ----------
TENZU_STORAGE__BACKEND_CLASS=storages.backends.s3.S3Storage
TENZU_STORAGE__AWS_STORAGE_BUCKET_NAME={{ tenzu_minio_bucket }}
TENZU_STORAGE__AWS_S3_ENDPOINT_URL=http://tenzu-minio:9000
TENZU_STORAGE__AWS_ACCESS_KEY_ID={{ tenzu_minio_root_user }}
TENZU_STORAGE__AWS_S3_SECRET_ACCESS_KEY={{ tenzu_minio_root_password }}

# Exposed to compose for the minio container itself + mc init
TENZU_MINIO_ROOT_PASSWORD={{ tenzu_minio_root_password }}

# ---------- Email (SMTP via group_vars/all.yml) ----------
TENZU_EMAIL__EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
TENZU_EMAIL__DEFAULT_FROM_EMAIL={{ email_user }}
TENZU_EMAIL__EMAIL_HOST={{ mail_host }}
TENZU_EMAIL__EMAIL_PORT={{ mail_smtp_port }}
TENZU_EMAIL__EMAIL_HOST_USER={{ email_user }}
TENZU_EMAIL__EMAIL_HOST_PASSWORD={{ email_password }}
TENZU_EMAIL__EMAIL_USE_TLS={{ 'True' if mail_use_tls else 'False' }}
TENZU_EMAIL__EMAIL_USE_SSL={{ 'True' if mail_use_ssl else 'False' }}

# ---------- LDAP / Active Directory ----------
# Disabled by default — Pydantic's LDAPSettings model expects USER_SEARCH
# as a JSON list of structured dicts (list[LDAPUserSearchParams]), not the
# `LDAPSearch(...)` Python literal that upstream dev.env uses. Until we
# nail down the right JSON shape, no LDAP keys are exported and Pydantic
# falls back to LDAPActivation.DONT_USE.
{% if tenzu_ldap_enabled | default(false) %}
TENZU_LDAP__ACTIVATION={{ tenzu_ldap_activation }}
TENZU_LDAP__SERVER_URI=ldap://{{ ldap_server }}
TENZU_LDAP__CONNECTION_OPTIONS={"8": 0}
TENZU_LDAP__BIND_AS_AUTHENTICATING_USER=False
TENZU_LDAP__BIND_DN={{ ldap_bind_dn }}
TENZU_LDAP__BIND_PASSWORD={{ ldap_bind_password }}
# TODO: USER_SEARCH needs to be a JSON list of LDAPUserSearchParams dicts.
# Format TBD — see tenzu-back src/configurations/conf/auth.py for the model.
TENZU_LDAP__USER_ATTR_MAP={{ tenzu_ldap_user_attr_map }}
TENZU_LDAP__USER_QUERY_FIELD={{ tenzu_ldap_user_query_field }}
{% endif %}

# ---------- Logging ----------
TENZU_LOGS__LOG_HANDLER={{ tenzu_log_handler }}
TENZU_LOGS__LOG_LEVELS='{"root": "{{ tenzu_log_level }}"}'
