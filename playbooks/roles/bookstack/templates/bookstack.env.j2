# This file, when named as ".env" in the root of your BookStack install
# folder, is used for the core configuration of the application.
# By default this file contains the most common required options but
# a full list of options can be found in the '.env.example.complete' file.

# NOTE: If any of your values contain a space or a hash you will need to
# wrap the entire value in quotes. (eg. MAIL_FROM_NAME="BookStack Mailer")

# Application key
# Used for encryption where needed.
# Run `php artisan key:generate` to generate a valid key.
APP_KEY={{ bookstack_app_key }}

# Application URL
# This must be the root URL that you want to host BookStack on.
# All URLs in BookStack will be generated using this value
# to ensure URLs generated are consistent and secure.
# If you change this in the future you may need to run a command
# to update stored URLs in the database. Command example:
# php artisan bookstack:update-url https://old.example.com https://new.example.com
APP_URL={{ bookstack_app_url }}

# Database details
DB_HOST='{{ bookstack_mysql_host }}'
DB_PORT='{{ bookstack_mysql_port }}'
DB_DATABASE='{{ bookstack_mysql_db_name }}'
DB_USERNAME='{{ bookstack_mysql_db_username }}'
DB_PASSWORD='{{ bookstack_mysql_password }}'
# MYSQL_ATTR_SSL_CA="/path/to/server-cert.pem"

# Mail system to use
# Can be 'smtp' or 'sendmail'
MAIL_DRIVER=smtp

# SMTP mail options
# These settings can be checked using the "Send a Test Email"
# feature found in the "Settings > Maintenance" area of the system.
# For more detailed documentation on mail options, refer to:
# https://www.bookstackapp.com/docs/admin/email-webhooks/#email-configuration
MAIL_HOST={{ mail_host }}
MAIL_PORT={{ mail_smtp_port }}
MAIL_USERNAME={{ email_user }}
MAIL_PASSWORD="{{ email_password }}"
MAIL_ENCRYPTION={{ 'tls' if mail_use_tls else ('ssl' if mail_use_ssl else 'null') }}
MAIL_FROM={{ bookstack_mail_from }}
MAIL_FROM_NAME="{{ bookstack_mail_from_name }}"
MAIL_VERIFY_SSL={{ bookstack_mail_verify_ssl | string | lower }}

# Authentication method to use
# Can be 'standard', 'ldap', 'saml2' or 'oidc'
AUTH_METHOD={{ bookstack_auth_method }}

# The LDAP host, Adding a port is optional
LDAP_SERVER={{ ldap_server }}
# If using LDAP over SSL you should also define the protocol:
# LDAP_SERVER=ldaps://example.com:636

# The base DN from where users will be searched within
LDAP_BASE_DN="{{ ldap_search_base }}"

# The full DN and password of the user used to search the server
# Can both be left as 'false' (without quotes) to bind anonymously
LDAP_DN="{{ ldap_bind_dn }}"
LDAP_PASS="{{ ldap_bind_password }}"

# A filter to use when searching for users
# The user-provided user-name used to replace any occurrences of '${user}'
# If you're setting this option via other means, such as within a docker-compose.yml,
# you may need escape the $, often using $$ or \$ instead.
# Note: This option cannot be used with the docker-compose.yml `env_file` option.
LDAP_USER_FILTER={{ bookstack_ldap_user_filter }}

# Set the LDAP version to use when connecting to the server
# Should be set to 3 in most cases.
LDAP_VERSION={{ bookstack_ldap_version }}

# Set the property to use as a unique identifier for this user.
# Stored and used to match LDAP users with existing BookStack users.
# Prefixing the value with 'BIN;' will assume the LDAP service provides the attribute value as
# binary data and BookStack will convert the value to a hexidecimal representation.
# Defaults to 'uid'.
LDAP_ID_ATTRIBUTE={{ bookstack_ldap_id_attribute }}

# Set the default 'email' attribute. Defaults to 'mail'
LDAP_EMAIL_ATTRIBUTE={{ bookstack_ldap_email_attribute }}

# Set the property to use for a user's display name. Defaults to 'cn'
LDAP_DISPLAY_NAME_ATTRIBUTE={{ bookstack_ldap_display_name_attribute }}

# Set the attribute to use for the user's avatar image.
# Must provide JPEG binary image data.
# Will be used upon login or registration when the user doesn't
# already have an avatar image set.
# Remove this option or set to 'null' to disable LDAP avatar import.
LDAP_THUMBNAIL_ATTRIBUTE={{ bookstack_ldap_thumbnail_attribute }}

# Force TLS to be used for LDAP communication.
# Use this if you can but your LDAP support will need to support it and
# you may need to import your certificate to the BookStack host machine.
# Defaults to 'false'.
LDAP_START_TLS={{ bookstack_ldap_start_tls | string | lower }}

# If you need to allow untrusted LDAPS certificates, add the below and uncomment (remove the #)
# Only set this option if debugging or you're absolutely sure it's required for your setup.
# If using php-fpm, you may want to restart it after changing this option to avoid instability.
#LDAP_TLS_INSECURE=true

# If you need to debug the details coming from your LDAP server, add the below and uncomment (remove the #)
# Only set this option if debugging since it will block logins and potentially show private details.
#LDAP_DUMP_USER_DETAILS=true
#
# Enable LDAP group sync, Set to 'true' to enable.
LDAP_USER_TO_GROUPS={{ bookstack_ldap_user_to_groups | string | lower }}

# LDAP user attribute containing groups, Defaults to 'memberOf'.
LDAP_GROUP_ATTRIBUTE="{{ bookstack_ldap_group_attribute }}"

# Remove users from roles that don't match LDAP groups.
# Note: While this is enabled the "Default Registration Role", editable within the
# BookStack settings view, will be considered a matched role and assigned to the user.
LDAP_REMOVE_FROM_GROUPS={{ bookstack_ldap_remove_from_groups | string | lower }}

# If you need to debug the group details coming from your LDAP server, add the below and uncomment (remove the #).
# Only set this option if debugging since it will block logins and potentially show private details.
#LDAP_DUMP_USER_GROUPS=true

# OIDC
AUTH_AUTO_INITIATE={{ bookstack_auth_auto_initiate | string | lower }}
OIDC_NAME={{ bookstack_oidc_name }}
OIDC_DISPLAY_NAME_CLAIMS={{ bookstack_oidc_display_name_claims }}
OIDC_CLIENT_ID={{ bookstack_oidc_client_id }}
OIDC_CLIENT_SECRET={{ bookstack_oidc_secret }}
OIDC_ISSUER={{ bookstack_oidc_issuer }}
OIDC_ISSUER_DISCOVER={{ bookstack_oidc_issuer_discover | string | lower }}
OIDC_END_SESSION_ENDPOINT={{ bookstack_oidc_end_session_endpoint | string | lower }}

# Enable OIDC group sync.
OIDC_USER_TO_GROUPS={{ bookstack_oidc_user_to_groups | string | lower }}

# Set the attribute from which BookStack will read groups names from.
OIDC_GROUPS_CLAIM={{ bookstack_oidc_groups_claim }}

# Additional scopes to send with the authentication request.
# By default BookStack only sends the 'openid', 'profile' & 'email' scopes.
# Many platforms require specific scopes to be requested for group data.
# Multiple scopes can be added via comma separation.
OIDC_ADDITIONAL_SCOPES={{ bookstack_oidc_additional_scopes }}

# Remove the user from roles that don't match OIDC groups upon login.
# Note: While this is enabled the "Default Registration Role", editable within the
# BookStack settings view, will be considered a matched role and assigned to the user.
OIDC_REMOVE_FROM_GROUPS={{ bookstack_oidc_remove_from_groups | string | lower }}
