#jinja2: lstrip_blocks: True
services:
  portainer:
    container_name: portainer
    image: {{ portainer_image }}:{{ portainer_version }}
    restart: {{ portainer_restart_policy }}
    command: --http-enabled{% if portainer_render_bootstrap | default(false) %} --admin-password-file /run/portainer-bootstrap/pwd{% endif %}

    ports:
      - "{{ portainer_http_port }}:9000"
      - "{{ portainer_https_port }}:9443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ portainer_data_volume }}:/data
{% if portainer_render_bootstrap | default(false) %}
      - {{ portainer_bootstrap_dir }}:/run/portainer-bootstrap:ro
{% endif %}
{% if portainer_mem_limit %}
    mem_limit: {{ portainer_mem_limit }}
{% endif %}
{% if portainer_cpus %}
    cpus: {{ portainer_cpus }}
{% endif %}
{% if portainer_no_new_privileges %}
    security_opt:
      - no-new-privileges:true
{% endif %}
{% if portainer_drop_all_caps %}
    cap_drop:
      - ALL
{% endif %}
{% if portainer_read_only %}
    read_only: true
    tmpfs:
      - /tmp
{% endif %}

volumes:
  {{ portainer_data_volume }}:
    name: {{ portainer_data_volume }}
