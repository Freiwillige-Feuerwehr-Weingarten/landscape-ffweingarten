PG_PASS={{ authentik_pg_pass }}
AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}
# debug, info, warning, error, trace
# AUTHENTIK_LOG_LEVEL=info
# AUTHENTIK_ERROR_REPORTING__ENABLED=true

# SMTP Host Emails are sent to
# AUTHENTIK_EMAIL__HOST={{ mail_host }}
# AUTHENTIK_EMAIL__PORT={{ mail_smtp_port }}
# Optionally authenticate (don't add quotation marks to your password)
# AUTHENTIK_EMAIL__USERNAME={{ authentik_email_user }}
# AUTHENTIK_EMAIL__PASSWORD={{ authentik_email_password }}
# Use StartTLS
# AUTHENTIK_EMAIL__USE_TLS={{ mail_use_tls }}
# Use SSL
# AUTHENTIK_EMAIL__USE_SSL= {{ mail_use_ssl }}
# AUTHENTIK_EMAIL__TIMEOUT=20
# Email address authentik will send from, should have a correct @domain
# AUTHENTIK_EMAIL__FROM=authentik@ff-weingarten.de

COMPOSE_PORT_HTTP=666
COMPOSE_PORT_HTTPS=667

KRB5_TRACE=/dev/stderr