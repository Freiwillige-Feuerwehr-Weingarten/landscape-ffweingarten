AUTHENTIK_IMAGE={{ authentik_image }}
AUTHENTIK_TAG={{ authentik_version }}

PG_USER={{ authentik_pg_user }}
PG_DB={{ authentik_pg_db }}
PG_PASS={{ authentik_pg_pass }}

AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}
AUTHENTIK_LOG_LEVEL={{ authentik_log_level }}

COMPOSE_PORT_HTTP={{ authentik_port_http }}
COMPOSE_PORT_HTTPS={{ authentik_port_https }}

KRB5_TRACE={{ authentik_krb5_trace }}

{% if authentik_smtp_enabled %}
AUTHENTIK_EMAIL__HOST={{ mail_host }}
AUTHENTIK_EMAIL__PORT={{ mail_smtp_port }}
AUTHENTIK_EMAIL__USERNAME={{ authentik_email_user }}
AUTHENTIK_EMAIL__PASSWORD={{ authentik_email_password }}
AUTHENTIK_EMAIL__USE_TLS={{ mail_use_tls }}
AUTHENTIK_EMAIL__USE_SSL={{ mail_use_ssl }}
AUTHENTIK_EMAIL__FROM={{ authentik_email_from }}
{% endif %}
