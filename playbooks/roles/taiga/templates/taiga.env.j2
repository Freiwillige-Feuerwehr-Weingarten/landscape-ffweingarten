# Taiga's URLs — how Taiga sees itself. NPM fronts taiga.ff-weingarten.de
# and reverse-proxies onto this. Currently set to the internal docker-host
# IP:port to preserve legacy behavior; not ideal because it leaks into
# emails. Move to the public URL as a separate change.
TAIGA_SCHEME={{ taiga_scheme }}
TAIGA_DOMAIN={{ taiga_domain }}
SUBPATH="{{ taiga_subpath }}"
WEBSOCKETS_SCHEME={{ taiga_websockets_scheme }}

# Cryptographic signing. DO NOT rotate against an existing DB.
SECRET_KEY="{{ taiga_secret_key }}"

# Database
POSTGRES_USER={{ taiga_postgres_user }}
POSTGRES_PASSWORD={{ taiga_postgres_password }}

# SMTP — values come from group_vars/all.yml
EMAIL_BACKEND={{ taiga_email_backend }}
EMAIL_HOST={{ mail_host }}
EMAIL_PORT={{ mail_smtp_port }}
EMAIL_HOST_USER={{ email_user }}
EMAIL_HOST_PASSWORD={{ email_password }}
EMAIL_DEFAULT_FROM={{ email_user }}
EMAIL_USE_TLS={{ 'True' if mail_use_tls else 'False' }}
EMAIL_USE_SSL={{ 'True' if mail_use_ssl else 'False' }}

# RabbitMQ
RABBITMQ_USER={{ taiga_rabbitmq_user }}
RABBITMQ_PASS={{ taiga_rabbitmq_password }}
RABBITMQ_VHOST={{ taiga_rabbitmq_vhost }}
RABBITMQ_ERLANG_COOKIE={{ taiga_rlang_cookie }}

# Attachments — token TTL in seconds
ATTACHMENTS_MAX_AGE={{ taiga_attachments_max_age }}

# Anonymous telemetry
ENABLE_TELEMETRY={{ taiga_telemetry }}
