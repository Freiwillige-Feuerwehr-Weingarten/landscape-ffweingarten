#!/bin/bash
# Managed by Ansible — edits here will be overwritten.
set -euo pipefail

source_dir="{{ docker_backup_source_dir }}"
backup_dir="{{ docker_backup_target_dir }}"
retention_days={{ docker_backup_retention_days }}
current_datetime="$(date +%Y-%m-%d_%H-%M-%S)"
backup_filename="${current_datetime}-{{ docker_backup_suffix }}-backup.tar"
backup_fullpath="${backup_dir}/${backup_filename}"

DOCKER="$(command -v docker)"
GZIP="$(command -v gzip)"
TAR="$(command -v tar)"
FIND="$(command -v find)"

{% if docker_backup_pre_stop_containers %}
# Stop containers that mustn't be live during the tar (top-to-bottom).
{% for container in docker_backup_pre_stop_containers %}
"${DOCKER}" stop {{ container }}
{% endfor %}
{% endif %}

"${TAR}" -cpf "${backup_fullpath}" "${source_dir}"

{% if docker_backup_pre_stop_containers %}
# Restart in reverse order so dependencies come up before dependents.
{% for container in docker_backup_pre_stop_containers | reverse %}
"${DOCKER}" start {{ container }}
{% endfor %}
{% endif %}

"${GZIP}" "${backup_fullpath}"

# Prune local backups older than retention_days.
"${FIND}" "${backup_dir}" -type f -name '*-backup.tar.gz' -mtime "+${retention_days}" -delete
